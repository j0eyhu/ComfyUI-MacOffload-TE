# ==============================================================================
# ComfyUI-MacOffload-TE Server Configuration (.env)
# Copy this file to .env and adjust paths for your local Mac environment.
# ==============================================================================

# Server Network Binding
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8288

# Dynamic Resident Memory Pool Management
# Maximum number of models kept resident concurrently in Apple Silicon Unified Memory
MAX_MODELS=2

# Idle timeout in seconds before auto-unloading inactive models (0 = disabled, keep resident)
IDLE_TIMEOUT=0

# Hardware Acceleration Device ('mps' for Apple Silicon, 'cuda' for Nvidia, or 'cpu')
# BRIDGE_DEVICE=mps

# Root directory containing text encoder model weights
# Default: ~/models
MODELS_DIR=~/models

# Individual Model Path Overrides (Optional - defaults to MODELS_DIR/<folder_name>)
# QWEN_MODEL_PATH=~/models/Qwen-Image-2.1-Text-Encoder-Heretic
# FLUX_KLEIN_4B_PATH=~/models/flux2-klein-4b-uncensored-text-encoder
# FLUX_KLEIN_9B_PATH=~/models/flux2-klein-9b-uncensored-text-encoder
